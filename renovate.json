{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "automerge": true,
  "labels": [
    "chore"
  ],
  "packageRules": [
    {
      "description": "Keycloak changes its internal APIs between minor versions, so check each update by hand",
      "matchPackageNames": [
        "org.keycloak:**"
      ],
      "automerge": false
    }
  ]
}
